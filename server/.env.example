PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://shridb:<db_password>@cluster0.sxey9po.mongodb.net/labco?retryWrites=true&w=majority

# Cache & Presence (Upstash Redis)
UPSTASH_REDIS_REST_URL=https://winning-sculpin-116227.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_read_write_token
# Fallback local/hosted Redis TCP connection
REDIS_URL=redis://localhost:6379

# JWT Secrets (replace with long, random strings in production)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# File Uploads (Cloudinary credentials)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Authentication (Google OAuth Client ID)
GOOGLE_CLIENT_ID=

# Transactional Email (Brevo / Sendinblue SMTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_brevo_login_email
SMTP_PASS=your_brevo_smtp_key
SMTP_FROM="LabCo" <noreply@yourdomain.com>
